<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l1" android:text="实时发电" />
            <TextView style="@style/WidgetValueAccent" android:id="@+id/v1" android:text="--" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l2" android:text="今日发电" />
            <TextView style="@style/WidgetValue" android:id="@+id/v2" android:text="--" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l3" android:text="当前负载" />
            <TextView style="@style/WidgetValue" android:id="@+id/v3" android:text="--" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l4" android:text="电池 SOC" />
            <TextView style="@style/WidgetValue" android:id="@+id/v4" android:text="--" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l5" android:text="充电功率" />
            <TextView style="@style/WidgetValue" android:id="@+id/v5" android:text="--" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l6" android:text="放电功率" />
            <TextView style="@style/WidgetValue" android:id="@+id/v6" android:text="--" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l7" android:text="今日充电" />
            <TextView style="@style/WidgetValue" android:id="@+id/v7" android:text="--" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetCell">
            <TextView style="@style/WidgetLabel" android:id="@+id/l8" android:text="市电功率" />
            <TextView style="@style/WidgetValue" android:id="@+id/v8" android:text="--" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
